# Add ONE of these in Vercel > Project > Settings > Environment Variables (and .env.local for `vercel dev`)

# FREE: create at https://aistudio.google.com/apikey (no credit card)
GEMINI_API_KEY=your-gemini-key-here
# GEMINI_MODEL=gemini-flash-latest

# Paid alternative (used first if both are set): https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Live classes (free LiveKit Cloud: https://cloud.livekit.io) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Google Classroom publishing (browser-side, safe to expose) ---
VITE_GOOGLE_CLIENT_ID=

# --- Optional: point at your own Supabase project ---
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
